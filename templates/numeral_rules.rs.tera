/// Build {{ dimension }} rules for {{ locale }}
pub fn build_{{ locale }}_{{ dimension }}_rules(builder: &mut RuleSetBuilder) {
    {% for rule in rules %}
    {% if rule.rule_type == "dictionary" %}
    // Dictionary rule: {{ rule.name }}
    {
        let dictionary = {{ rule.name | upper }}.clone();
        builder.add_rule(
            Rule::new("{{ locale }}:{{ rule.name }}")
                .pattern(Pattern::Dictionary(dictionary.clone()))
                .production(move |ctx| {
                    let text = ctx.matched_text().to_lowercase();
                    dictionary.get(text.as_str()).map(|&value| {
                        Token::Integer(IntegerValue {
                            value,
                            grain: None,
                            latent: false,
                        })
                    })
                })
                .confidence({{ rule.production.confidence | default(value=1.0) }})
        );
    }
    {% endif %}

    {% if rule.rule_type == "regex" %}
    // Regex rule: {{ rule.metadata.original_name | default(value=rule.name) }}
    {% if rule.metadata._needs_manual_review %}
    // ⚠️  NEEDS MANUAL REVIEW: Complex production logic
    // Original Haskell: {{ rule.production.custom_logic }}
    {% endif %}
    builder.add_rule(
        Rule::new("{{ locale }}:{{ rule.name }}")
            .pattern(Pattern::Regex(
                regex::Regex::new(r"{{ rule.pattern.value }}").unwrap()
            ))
            .production(|ctx| {
                {% if rule.production.dictionary_ref %}
                // Dictionary lookup via regex match
                let text = ctx.matched_text().to_lowercase();
                {{ rule.production.dictionary_ref | upper }}.get(text.as_str()).map(|&value| {
                    Token::Integer(IntegerValue {
                        value,
                        grain: None,
                        latent: false,
                    })
                })
                {% else %}
                // TODO: Implement custom production logic
                // {{ rule.production.custom_logic }}
                None
                {% endif %}
            })
            .confidence({{ rule.production.confidence | default(value=1.0) }})
    );
    {% endif %}

    {% if rule.rule_type == "composite" %}
    // ⚠️  COMPOSITE RULE - NEEDS MANUAL IMPLEMENTATION
    // Rule: {{ rule.metadata.original_name | default(value=rule.name) }}
    // Pattern: {{ rule.pattern._raw_haskell }}

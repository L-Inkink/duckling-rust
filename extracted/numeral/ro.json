      "production": {
        "value_extractor": "custom",
        "custom_logic": "NEEDS_MANUAL_REVIEW: prod = \\case\n      (Token RegexMatch (GroupMatch (match:_)):\n       _) -> let fmt = Text.replace \",\" \".\" $ Text.replace \".\" Text.empty match\n        in parseDouble fmt >>= double\n      _ -> Nothing\n  ",
        "confidence": 1.0
      },
      "metadata": {
        "original_name": "decimal with thousands separator",
        "_needs_manual_review": true
      }

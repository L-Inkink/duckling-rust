      "production": {
        "value_extractor": "custom",
        "custom_logic": "NEEDS_MANUAL_REVIEW: prod = \\tokens -> case tokens of\n      (Token RegexMatch (GroupMatch (match:_)):_) -> parseDecimal True match\n      _ -> Nothing\n  ",
        "confidence": 1.0
      },
      "metadata": {
        "original_name": "decimal number",
        "_needs_manual_review": true
      }
    },
    {
      "name": "NumeralsPrefixWithOr",
      "rule_type": "regex",
      "pattern": {

    {
      "name": "DecimalWithThousandsSeparator",
      "rule_type": "regex",
      "pattern": {
        "type": "regex",
        "value": "(?:\\\\d+(?:,\\\\d\\\\d\\\\d)+\\\\.\\\\d+)",
        "flags": "i"
      },
      "production": {
        "value_extractor": "custom",
        "custom_logic": "NEEDS_MANUAL_REVIEW: prod = \\tokens -> case tokens of\n      (Token RegexMatch (GroupMatch (match:_)):_) ->\n        parseDouble (Text.replace \",\" Text.empty match) >>= double\n      _ -> Nothing\n  ",
        "confidence": 1.0
      },
      "metadata": {
        "original_name": "decimal with thousands separator",
        "_needs_manual_review": true
      }
    },

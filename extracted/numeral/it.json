    {
      "name": "NumeralsPrefixWithNegativeOrMinus",
      "rule_type": "regex",
      "pattern": {
        "type": "regex",
        "value": "-|meno|negativo",
        "flags": "i"
      },
      "production": {
        "value_extractor": "custom",
        "custom_logic": "NEEDS_MANUAL_REVIEW: prod = \\tokens -> case tokens of\n      (_:Token Numeral nd:_) -> double (TNumeral.value nd * (-1))\n      _ -> Nothing\n  ",
        "confidence": 1.0
      },
      "metadata": {
        "original_name": "numbers prefix with -, negative or minus",
        "_needs_manual_review": true
      }
    },
    {
      "name": "DecimalWithThousandsSeparator",
      "rule_type": "regex",
      "pattern": {
        "type": "regex",
        "value": "(\\\\d+(([\\\\. ])\\\\d\\\\d\\\\d)+,\\\\d+)",
        "flags": "i"
      },
      "production": {
        "value_extractor": "custom",
        "custom_logic": "NEEDS_MANUAL_REVIEW: prod = \\tokens -> case tokens of\n      (Token RegexMatch (GroupMatch (match:_:sep:_)):\n       _) -> let fmt = Text.replace \",\" \".\" $ Text.replace sep Text.empty match\n        in parseDouble fmt >>= do",
        "confidence": 1.0
      },
      "metadata": {
        "original_name": "decimal with thousands separator",
        "_needs_manual_review": true
      }
    },
    {
      "name": "DecimalNumeral",

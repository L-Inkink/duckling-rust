# Environment variables for Rustling HTTP Server
# Copy this file to .env and customize as needed

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info

# API key for config reload endpoint (optional)
# If not set, reload endpoint will be disabled
RELOAD_API_KEY=

# Rust backtrace (0 or 1)
RUST_BACKTRACE=1

# Optional: Apollo configuration (requires 'apollo' feature)
# APOLLO_APP_ID=rustling
# APOLLO_CONFIG_SERVER=http://apollo:8080
# APOLLO_CLUSTER=default
# APOLLO_NAMESPACE=application

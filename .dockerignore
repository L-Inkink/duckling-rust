# Rust build artifacts
target/
**/*.rs.bk
*.pdb

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Git files
.git/
.gitignore
.gitattributes

# Documentation (not needed in container)
*.md
docs/
!README.md

# Test files
tests/
benches/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Docker files (avoid recursion)
Dockerfile*
docker-compose*.yml
.dockerignore

# macOS
.DS_Store
**/.DS_Store

# Environment files (should use docker-compose env instead)
.env
.env.*

# Logs
*.log

# Temporary files
tmp/
temp/
